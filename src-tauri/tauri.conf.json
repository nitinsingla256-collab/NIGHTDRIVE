{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/1.x/core/tauri-config-schema/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../engine",
    "distDir": "../engine",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "NIGHTDRIVE",
    "version": "1.3.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": "^(https?://|ms-settings:|x-apple\\.systempreferences:)"
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.nightdrive.desktop",
      "shortDescription": "Cinematic time-aware desktop wallpaper",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "NIGHTDRIVE",
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "width": 1366,
        "height": 768
      }
    ]
  }
}
